# Copia este archivo como .env o define estas variables en Windows.
# Nunca subas .env ni pegues claves en config.py.
GEMINI_API_KEY=pega_aqui_una_clave_nueva
OPENAI_API_KEY=pega_aqui_una_clave_nueva
# auto usa Gemini, luego OpenAI y finalmente Bark local. Valores: auto, gemini, openai, local
BARK_PROVEEDOR=auto
GEMINI_MODELO=gemini-2.5-flash
OPENAI_MODELO=gpt-4.1-mini
# Voz de nube opcional, cálida y calmada; Piper sigue siendo el respaldo local.
BARK_VOZ=auto
OPENAI_VOZ=coral
# Ciudad para «qué clima hace» cuando no dices cuál (si se omite, se estima por tu IP).
BARK_CIUDAD=Tulancingo
# Estilo Live: hablar por encima de Bark lo interrumpe (1 = activado). Úsalo con audífonos:
# sin ellos el micrófono también oye a Bark. Sube el umbral si se interrumpe solo.
BARK_INTERRUMPIR_VOZ=0
# Gemini Live: conversación voz a voz en tiempo real. auto = si hay GEMINI_API_KEY; 0 = modo clásico.
BARK_GEMINI_LIVE=auto
GEMINI_MODELO_LIVE=gemini-3.8-live
BARK_VOZ_UMBRAL_INTERRUPCION=900
# Tokens para conectores MCP remotos; se referencian como ${GITHUB_TOKEN} en conectores_mcp.json.
GITHUB_TOKEN=
# Modelo local: auto lo elige según tu RAM (8 GB → Qwen3 1.7B … 64 GB → DeepSeek R1 32B).
# También acepta un archivo de modelos/ o una clave: qwen3-1.7b, qwen3-4b, qwen3-8b, qwen3-30b-a3b, deepseek-r1-32b
BARK_MODELO_LLM=auto
# auto usa la GPU solo si llama-cpp-python se instaló con CUDA/Vulkan; 0 = solo CPU
BARK_GPU_LAYERS=auto
# Vacío = micrófono automático. Pon un índice (ver «Probar micrófono») para fijarlo.
BARK_MIC_DEVICE=
